# .gitignore for Unreal Engine projects with embedded Wwise projects
# This is a work in progress, please report any issues to Quin Henshaw

# Unreal
DerivedDataCache/
Intermediate/
Plugins/*/Intermediate/*
Plugins/FMODStudio/Binaries/Win64/UE4Editor*
Saved/
Build/
Builds/
Test/
Release/
AutoBuildLogs/
lfs/
hooks/
/Binaries/
/Plugins/**/Binaries
/Plugins/**/Intermediate
/Plugins/**/ASCCache

# Fmod Project
FMOD/.user/
FMOD/.unsaved/
FMOD/.cache/
FMOD/.restore/
FMOD/user/
FMOD/unsaved/
FMOD/restore/
FMOD/fmod.log
FMOD/fmod_editor.log

# Code Editors
.vs/
.gradle/
.vscode/
.idea/

# Autogenerated solution and project files
*.csproj
*.sdf
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.booproj
*.svd
*.opensdf
*.opendb
*.VC.db
*.xcodeproj
*.xcworkspace
*.vsconfig

# Windows
Thumbs.db
Thumbs.db.meta

# Stuff that shouldn't ever be there
.play

# Mac
*.DS_Store

# EOS client credentials (loaded with -CustomConfig=EOS). Never commit: the repo is public.
Config/Custom/EOS/DefaultEngine.ini
